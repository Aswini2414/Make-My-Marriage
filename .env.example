# Copy to .env.local and fill in. Never commit real values.
# The same variables are set in Vercel's project settings for production.

# MongoDB Atlas connection string. Use the mmm_dev database for development.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mmm_dev

# Long random string for signing sessions (at least 32 characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 32-byte key, base64, for encrypting guest invitation and QR tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# The app's base address, used in email links and the Origin check.
APP_URL=http://localhost:3000

# Cloudflare R2. Use the mmm-dev bucket for development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mmm-dev

# Dedicated Gmail account with 2-step verification and an App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Daily email stop, a safety margin under Gmail's ~500 a day.
EMAIL_DAILY_CAP=450
