# Copy to .env.local and fill in. Never commit real values.
# The same variables are set in Vercel (Project Settings > Environment Variables) for production.
# Production needs its own value for every secret: never reuse the development ones.
# Setting guide for production: docs/deployment.md

# ---- Core: needed for the app to work at all (validated on first use, not at startup) ----

# MongoDB Atlas connection string, starting with mongodb:// or mongodb+srv://.
# The database name goes after the last slash: mmm_dev for development, mmm_prod for production.
# Special characters in the password must be URL-encoded (@ is %40, : is %3A, / is %2F).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mmm_dev

# Secret for signing login sessions. At least 32 characters; any long random text works.
# Generate (gives 64 characters): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later logs everyone out.
JWT_SECRET=

# Key for encrypting guest invitation and QR tokens. Must decode to exactly 32 bytes,
# written as standard base64: 44 characters ending in "=".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once guests have links: old links stop working. Back it up with your other secrets.
TOKEN_ENCRYPTION_KEY=

# The app's public address: scheme and host only, no path and no trailing slash
# (https://makemymarriage.example in production). Used in email links, page metadata and the
# Origin check on every write, so it must match what people type in the browser exactly.
# Also needed while the app is being built, not only while it runs.
APP_URL=http://localhost:3000

# ---- Email: needed to send invites, invitations and password resets ----
# Any SMTP provider works. Production sends through Resend from our own domain
# (makemymarriage.cyou); steps in docs/deployment.md. Use a separate Resend API key for
# production and for local work, and never commit one.

# To use the deprecated Gmail fallback instead, delete (or comment out) the SMTP_* lines and
# EMAIL_FROM_ADDRESS and EMAIL_DAILY_CAP below: while SMTP_HOST is set it wins.
#
# The provider's SMTP server. Port 465 is a secure connection from the start; other ports
# (587, 2525) use STARTTLS. For Resend, SMTP_USER is the literal word "resend" and
# SMTP_PASSWORD is the API key (a "Sending access" key limited to the domain).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=

# Who emails come from. The address must be on a domain verified with the provider.
EMAIL_FROM_ADDRESS=invitations@makemymarriage.cyou
EMAIL_FROM_NAME=Make My Marriage

# Leave unset. Our emails are no-reply by design: nobody reads the From address, and every
# email says "This is an automatic email, so replies are not read." A guest who needs the couple
# uses the invitation page. (If a monitored inbox is ever added, set it here.)
# EMAIL_REPLY_TO=

# Optional, development and tests only: send EVERY email to this one address instead of to its
# real recipient, with "[redirected]" in the subject. It is IGNORED in production (with a
# warning), so do not set it in Vercel.
# EMAIL_DEV_REDIRECT=

# One stop for every email the app sends (invitations, reminders, password resets, member
# invites), shared by all weddings. A whole number, and it MUST stay below the provider's own
# daily limit. Resend free: 100 a day (and about 3,000 a month, which the app does not count).
# Gmail: about 500 a day. Optional: defaults to 90 with the SMTP settings, 450 with Gmail.
EMAIL_DAILY_CAP=90

# Optional: how fast a batch of invitations may send, emails per second (default 2, about what
# Resend's free plan allows). Leave it alone unless the provider says otherwise.
# EMAIL_SENDS_PER_SECOND=2

# DEPRECATED fallback, used only when SMTP_HOST is not set. When both are set, SMTP_* wins.
# Dedicated Gmail account (2-step verification on) and its 16-letter App Password, written
# without spaces. Remove these once the SMTP settings work in every environment.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# ---- Cloudflare R2: not used yet (photo and receipt uploads arrive in Phase 8) ----
# Leave these empty for now. Only the features that need files will complain, with a clear message.
# R2_ACCOUNT_ID is the 32-character hex Account ID shown in the Cloudflare dashboard.
# R2_BUCKET is the bucket name only: mmm-dev for development, mmm-prod for production.
# The token behind the key pair should be limited to that one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mmm-dev

# ---- Optional, development only ----

# Build into another folder, so a production build can be tested while `next dev` runs.
# Never set this in Vercel.
# NEXT_DIST_DIR=.next-check
